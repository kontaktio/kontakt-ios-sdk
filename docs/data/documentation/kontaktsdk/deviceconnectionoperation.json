e":"text"},{"text":"subclass’s defaulted-parameter overload for a bare call, so every ","type":"text"},{"type":"codeVoice","code":"add(gattOperation)"},{"text":" ","type":"text"},{"text":"call site across this hierarchy (every ","type":"text"},{"inlineContent":[{"type":"text","text":"required"}],"type":"emphasis"},{"text":", i.e. non-optional, GATT operation)","type":"text"},{"text":" ","type":"text"},{"text":"was silently resolving here instead of into ","type":"text"},{"type":"codeVoice","code":"add(_:withOptionalChar:)"},{"text":" below — skipping","type":"text"},{"text":" ","type":"text"},{"text":"GATT registration, delegate assignment, and dependency wiring entirely. The operation","type":"text"},{"text":" ","type":"text"},{"text":"still landed in the internal queue (via this method) but could never be discovered,","type":"text"},{"text":" ","type":"text"},{"text":"characteristic-assigned, or executed, wedging the whole group until the connection-level","type":"text"},{"text":" ","type":"text"},{"text":"timeout. Overriding the exact ancestor signature here and redirecting ","type":"text"},{"type":"codeVoice","code":"DeviceGATTOperation"},{"text":" ","type":"text"},{"text":"instances fixes every call site without touching them.","type":"text"}],"kind":"symbol","url":"\/documentation\/kontaktsdk\/deviceconnectionoperation\/add(_:)","identifier":"doc:\/\/ios-sdk.KontaktSDK\/documentation\/KontaktSDK\/DeviceConnectionOperation\/add(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"add","kind":"identifier"},{"text":"(Foundation","kind":"text"},{"text":".","kind":"text"},{"text":"Operation","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSOperation"},{"text":")","kind":"text"}]},"doc://ios-sdk.KontaktSDK/objc(pl)NSObject":{"type":"unresolvable","identifier":"doc:\/\/ios-sdk.KontaktSDK\/objc(pl)NSObject","title":"ObjectiveC.NSObjectProtocol"}}}